{
  "name": "space-background-engine",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Procedural background engine. Seeded skins, layered atmosphere. Drop onto any site via mount() or <bg-engine>.",
  "keywords": [
    "background",
    "canvas",
    "procedural",
    "generative",
    "web-component",
    "webgl",
    "shader",
    "design-tokens"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/element.js",
    "./dist/react.js",
    "./dist/vue.js",
    "./dist/svelte.js",
    "./dist/skins/*.js",
    "./dist/layers.js",
    "./dist/presets.js",
    "./src/engine/skins/index.ts",
    "./src/engine/layers/index.ts",
    "./src/engine/presets/index.ts",
    "./src/entries/skins/*.ts",
    "./src/element.ts",
    "./src/adapters/*.ts",
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/lib.d.ts",
  "bin": {
    "bg-engine": "bin/bg-engine.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/lib.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./types/entries/core.d.ts",
      "import": "./dist/core.js"
    },
    "./skins/void-tactical": {
      "types": "./types/entries/skins/void-tactical.d.ts",
      "import": "./dist/skins/void-tactical.js"
    },
    "./skins/drifting-dust": {
      "types": "./types/entries/skins/drifting-dust.d.ts",
      "import": "./dist/skins/drifting-dust.js"
    },
    "./skins/matrix-rain": {
      "types": "./types/entries/skins/matrix-rain.d.ts",
      "import": "./dist/skins/matrix-rain.js"
    },
    "./shader": {
      "types": "./types/entries/shader.d.ts",
      "import": "./dist/shader.js"
    },
    "./manifest": {
      "types": "./types/entries/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./tokens": {
      "types": "./types/entries/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./layers": {
      "types": "./types/entries/layers.d.ts",
      "import": "./dist/layers.js"
    },
    "./presets": {
      "types": "./types/entries/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./element": {
      "types": "./types/element.d.ts",
      "import": "./dist/element.js"
    },
    "./react": {
      "types": "./types/react-entry.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./types/adapters/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./types/adapters/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./tailwind.css": "./tailwind/tokens.css",
    "./tailwind-preset": "./tailwind/preset.js",
    "./registry": "./registry/index.json",
    "./registry/preset.schema.json": "./registry/preset.schema.json"
  },
  "files": [
    "dist",
    "types",
    "bin",
    "registry",
    "tailwind",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "build:types": "tsc -p tsconfig.lib.json",
    "build:lib": "vite build --config vite.lib.config.ts && pnpm build:types",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "create-skin": "node scripts/create-skin.mjs",
    "skin:check": "node scripts/skin-check.mjs",
    "registry": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "schema-diff": "node scripts/schema-diff.mjs",
    "sync-gallery": "node scripts/sync-gallery.mjs",
    "compare": "node scripts/prepare-compare.mjs",
    "build:site": "pnpm sync-gallery && vite build --base=./",
    "size": "node scripts/size-check.mjs",
    "sim": "node scripts/sim.mjs",
    "lab": "node scripts/lab.mjs",
    "test:sim": "vitest run src/**/*.sim.test.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm registry:check && pnpm build:lib && pnpm size && pnpm schema-diff --check"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^30.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
