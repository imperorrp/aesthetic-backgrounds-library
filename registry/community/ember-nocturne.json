{
  "$schema": "../preset.schema.json",
  "manifestVersion": 1,
  "id": "ember-nocturne",
  "label": "Ember nocturne",
  "description": "Slow embers rising through warm smoke, held low behind text. A community example published as data only.",
  "tags": ["warm", "dark", "calm", "music"],
  "author": { "name": "Example contributor", "url": "https://github.com/imperorrp/aesthetic-backgrounds-library" },
  "config": {
    "palette": { "from": "#f97316", "theme": "dark", "harmony": "analogous" },
    "intensity": 0.7
  },
  "scene": {
    "layers": [
      { "use": "gradient-base", "with": { "tint": 0.35, "drift": 0.15, "spread": 25 } },
      { "use": "aurora", "with": { "bands": 2, "height": 0.6, "speed": 0.12, "spread": 20, "ripple": 0.7, "position": 0.85 }, "opacity": 0.55, "blend": "lighter" },
      { "use": "particles-drift", "with": { "count": 70, "size": 1.4, "speed": 0.35, "glow": 0.85, "pulse": 0.5, "turbulence": 0.7, "color": "accent" } },
      { "use": "vignette", "with": { "strength": 0.6 } },
      { "use": "grain", "with": { "opacity": 0.08 } }
    ]
  }
}
